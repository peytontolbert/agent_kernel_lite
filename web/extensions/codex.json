{
  "id": "codex",
  "name": "Codex",
  "version": "0.1.0",
  "source": "official",
  "default_enabled": false,
  "approval_policy": "always_ask",
  "capabilities": [
    {
      "id": "codex.session.start",
      "description": "Start a Codex session in an approved local workspace.",
      "scopes": ["workspace.read", "codex.session.write"]
    },
    {
      "id": "codex.session.send",
      "description": "Send a prompt or follow-up to a paired Codex session.",
      "scopes": ["prompt.read", "codex.session.write"]
    },
    {
      "id": "codex.session.status",
      "description": "Read status and streamed events from a Codex session.",
      "scopes": ["codex.session.read"]
    },
    {
      "id": "codex.session.cancel",
      "description": "Cancel a running Codex session.",
      "scopes": ["codex.session.write"]
    },
    {
      "id": "codex.diff.read",
      "description": "Read Codex-produced diffs for review in the app.",
      "scopes": ["workspace.diff.read"]
    }
  ],
  "metadata": {
    "adapter": "local_bridge",
    "bridge_name": "agent-kernel-codex-bridge",
    "loopback_only": true,
    "default_port": 45731,
    "setup": "Install and pair the local Codex bridge before enabling this extension."
  }
}
